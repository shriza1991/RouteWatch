# Set privately in your shell or untracked .env before Compose startup.
# No management token is committed or passed to the dashboard/agent.
SANDBOX_MANAGEMENT_TOKEN=

# Native startup paths (Compose explicitly uses /data paths).
SANDBOX_DB=./data/sandbox.db
AGENT_DB=./data/agent.db
VOYAGEGUARD_V1_DB=./data/voyageguard-v1.db

# Required local-v1 demo reviewer secret (never prefix with VITE_).
VOYAGEGUARD_REVIEWER_TOKEN=
VOYAGEGUARD_REVIEWER_ID=local-demo-reviewer
