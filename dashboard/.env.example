# Keep legacy mode until the v1 domain and inventory services are connected.
VITE_DASHBOARD_API_MODE=legacy
VITE_AGENT_URL=http://localhost:8001
VITE_SANDBOX_URL=http://localhost:8000

# Set VITE_DASHBOARD_API_MODE=v1 to exercise the v1 polling UI.
# Vite proxies /v1-api to avoid browser CORS; use localhost for native startup
# or v1-transport when the dashboard runs inside the Compose network.
VITE_V1_PROXY_TARGET=http://localhost:8012
# These are server-side credential reference names, never tokens.
VITE_AGENCY_A_CREDENTIAL_REF=server:agency-a
VITE_AGENCY_B_CREDENTIAL_REF=server:agency-b
